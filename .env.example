# ---- Database (PostgreSQL 15+) ----
# Local: `npm run db:up` starts Postgres from docker-compose.yml with these credentials.
# Production: use your Neon / Supabase / any Postgres URL (pooled URL is fine).
DATABASE_URL=postgres://campus:campus@localhost:5432/campus
DB_POOL_MAX=5

# Public base URL of the deployed app (used for QR codes). Optional locally.
APP_URL=http://localhost:3000

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ---- Seed (only used by `npm run db:seed`) ----
# The super admin (platform owner) account created by the seed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
# Password for the demo restaurant staff accounts (owner/kitchen/cashier/delivery).
SEED_DEMO_PASSWORD=change-me-demo-password
