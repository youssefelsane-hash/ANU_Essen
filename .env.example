# ---- Database (PostgreSQL 15+) ----
# Local: `npm run db:up` starts Postgres from docker-compose.yml with these credentials.
# Production: use your Neon / Supabase / any Postgres URL (pooled URL is fine).
DATABASE_URL=postgres://campus:campus@localhost:5432/campus
# Optional direct connection for migration DDL (otherwise DATABASE_URL is used).
# DATABASE_MIGRATION_URL=postgres://...
DB_POOL_MAX=5

# Public base URL of the deployed app (used for QR codes). Optional locally.
APP_URL=http://localhost:3000

# Session lifetime (days). No AUTH_SECRET is used: sessions live in PostgreSQL.
SESSION_TTL_DAYS=30

# Campus visitors may share one Wi-Fi/mobile NAT IP. Individual phone protection stays tight.
ORDER_IP_RATE_LIMIT=600
ORDER_PHONE_RATE_LIMIT=8
QUOTE_IP_RATE_LIMIT=1200

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ---- First platform owner on a new deployment (optional) ----
# Set both in Vercel for the first deploy: the build creates this super admin only if none exists,
# never changes an existing account. Delete BOOTSTRAP_ADMIN_PASSWORD after you sign in.
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_PASSWORD=at-least-12-characters

# ---- Seed (only used by `npm run db:seed`) ----
# The super admin (platform owner) account created by the seed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
# Create the demo restaurant locally; use false against production.
SEED_DEMO=true
# Password for the demo restaurant staff accounts (owner/kitchen/cashier/delivery).
SEED_DEMO_PASSWORD=change-me-demo-password
